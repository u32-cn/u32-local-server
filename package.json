{
  "name": "u32-local-server",
  "version": "1.8.2",
  "description": "Local HTTP file server and proxy",
  "main": "src/index.js",
  "bin": {
    "u32-local-server": "src/index.js",
    "u32-ls": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js start",
    "dev": "node --watch src/index.js start"
  },
  "keywords": [
    "local-server",
    "file-server",
    "proxy",
    "cors"
  ],
  "author": "vtxf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u32-cn/u32-local-server.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "public",
    "docs/readme",
    "docs/llms.txt",
    "docs/index.html",
    "docs/reader.html",
    "docs/assets",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
  }
}
